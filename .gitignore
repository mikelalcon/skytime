# Go build artifacts
/bin/
/vendor/
*.test
*.out
coverage.txt
coverage.html

# Stray binary from `go build ./cmd/skytime` at repo root
/skytime
# Stray binary from `go build ./cmd/skytime-docgen` at repo root
/skytime-docgen
# Stray example binaries from `go build -o ./extbin ./examples/...`
# (the README + walkthroughs all show this as the canonical build path).
/extbin
/examples/http-github-webhook/extbin

# Editor
.idea/
.vscode/
*.swp

# OS
.DS_Store
Thumbs.db

# Skytime credfile (defense-in-depth — credfiles live at ~/.skytime-credentials by default;
# these patterns prevent accidental commits if a user copies one into the repo).
.skytime-credentials
.skytime-credentials.local
*.skytime-credentials
!*.skytime-credentials.example
